{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomList",
  "type": "object",
  "properties": {
    "rooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Room"
      }
    }
  },
  "required": [
    "rooms"
  ],
  "$defs": {
    "MatchInfo": {
      "type": "object",
      "properties": {
        "ends_at": {
          "type": "integer",
          "format": "int64"
        },
        "finalized": {
          "description": "끝나고 1시간 뒤 서버가 확정한다. 그전 순위는 잠정이다.",
          "type": "boolean"
        },
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "rule": {
          "type": "string"
        },
        "starts_at": {
          "description": "유닉스 초.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "rule",
        "starts_at",
        "ends_at",
        "finalized"
      ]
    },
    "Member": {
      "type": "object",
      "properties": {
        "endpoints": {
          "description": "로그인한 기기마다 하나.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "login": {
          "type": "string"
        },
        "user_id": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "user_id",
        "login",
        "endpoints"
      ]
    },
    "Room": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "description": "URL에 쓸 수 있는 12자(`[A-Za-z0-9_-]`).",
          "type": "string"
        },
        "match": {
          "description": "진행 중이거나 24시간 안에 확정된 가장 최근 경기.",
          "anyOf": [
            {
              "$ref": "#/$defs/MatchInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "description": "들어온 순서.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Member"
          }
        }
      },
      "required": [
        "id",
        "host_id",
        "members"
      ]
    }
  }
}
