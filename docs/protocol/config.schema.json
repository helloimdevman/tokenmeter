{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerConfig",
  "type": "object",
  "properties": {
    "active_s": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "idle_s": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "invite": {
      "type": "string"
    },
    "live": {
      "type": "boolean"
    },
    "relay": {
      "type": "string"
    }
  },
  "required": [
    "relay",
    "invite",
    "active_s",
    "idle_s",
    "live"
  ]
}
