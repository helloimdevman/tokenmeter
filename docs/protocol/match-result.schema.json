{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatchResult",
  "description": "`GET /v1/rooms/{id}/matches/latest`. 점수 높은 순.",
  "type": "object",
  "properties": {
    "match": {
      "$ref": "#/$defs/MatchInfo"
    },
    "standings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Standing"
      }
    }
  },
  "required": [
    "match",
    "standings"
  ],
  "$defs": {
    "MatchInfo": {
      "type": "object",
      "properties": {
        "ends_at": {
          "type": "integer",
          "format": "int64"
        },
        "finalized": {
          "description": "끝나고 1시간 뒤 서버가 확정한다. 그전 순위는 잠정이다.",
          "type": "boolean"
        },
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "rule": {
          "type": "string"
        },
        "starts_at": {
          "description": "유닉스 초.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "rule",
        "starts_at",
        "ends_at",
        "finalized"
      ]
    },
    "Standing": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "score": {
          "description": "규칙이 output이면 토큰 수, cost면 USD.",
          "type": "number",
          "format": "double"
        },
        "started": {
          "description": "시작 기록이 있는가. 없으면 0점이다.",
          "type": "boolean"
        },
        "user_id": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "user_id",
        "login",
        "score",
        "started"
      ]
    }
  }
}
