{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthRequest",
  "description": "`POST /v1/auth/github`. GitHub 토큰은 서버가 확인한 뒤 바로 폐기한다.",
  "type": "object",
  "properties": {
    "endpoint_id": {
      "description": "이 기기의 iroh EndpointId(소문자 16진수 64자).",
      "type": "string"
    },
    "github_token": {
      "type": "string"
    }
  },
  "required": [
    "github_token",
    "endpoint_id"
  ]
}
